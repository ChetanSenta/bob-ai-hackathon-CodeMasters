# Mission Readiness Officer — Backend Environment Variables
#
# Copy this file to .env and fill in real values before running the backend.
# For local/demo use, the SQLite fallback works without any changes.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production / Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_readiness
# SQLite (local demo — no PostgreSQL required):
# DATABASE_URL=sqlite:///./mission_readiness.db

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Leave as placeholder to use the deterministic template fallback (no API call).
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
