# Mission Readiness Officer — Environment Variables
#
# Copy this file to .env and fill in real values before running the stack.
# The watsonx.ai variables are optional for demo — the backend falls back to
# a template-based explanation when no API key is provided.
#
#   cp .env.example .env

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── IBM Bob Copilot ───────────────────────────────────────────────────────────
BOB_API_KEY=your_bob_api_key_here
BOB_API_URL=https://your-bob-instance.ibm.com

# ── Database (Docker Compose sets this automatically) ─────────────────────────
# Override only when running manually without Docker Compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_readiness
